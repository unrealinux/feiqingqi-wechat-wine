# 统一行尾为 LF，避免 Windows 检出（core.autocrlf=true）触发
# ESLint 的 linebreak-style 报错 —— 那是环境假错误，不是代码问题。
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bundle binary

# 明确文本类型
*.js   text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Windows 批处理与 VBS 脚本必须用 CRLF：
# 批处理文件在 LF 行尾下 goto/标签 与行尾拼接易出问题
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.vbs  text eol=crlf
