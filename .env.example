# ============================================================================
# 说明：当前主线是 engine/ 渲染引擎，实际需要：
#   - 微信公众号：WECHAT_APPID / WECHAT_SECRET（及可选的端点覆盖）
#   - AI 封面（可选但推荐）：GLM_API_KEY / ZIMAGE_API_KEY / GEMINI_API_KEY
#   - 自动写稿（可选，取代人工写 articles/*.json）：需要**文本**大模型 Key，
#     见下文「文本大模型（自动写稿）」，`GLM_API_KEY` 同时可供文本与封面使用
#   - 发布自检与监控：IP_WATCH_* / NOTIFY_* / SMTP_*
#   - 网络代理：HTTP_PROXY / HTTPS_PROXY
# 下面标注「【已归档】」的段（LLM / 数据库 / Redis / RSS / 新闻 API）
# 服务于 archive/first-gen/ 的第一代流水线，主线已不读取；保留仅为复活时参考。
# 注意：自动写稿读的**不是**下面这组 LLM_* 变量，而是 engine/llm.js 里的
# 提供商表（GLM_API_KEY / DEEPSEEK_API_KEY / SILICONFLOW_API_KEY 等）。
# ============================================================================

# 【已归档】LLM 提供商配置（支持多种免费/低成本模型）
# 提供商: openai / minimax / deepseek / zhipu / ollama
LLM_PROVIDER=minimax

# 模型名称
# - MiniMax: abab6.5s-chat (推荐，完全免费)
# - DeepSeek: deepseek-chat
# - 智谱AI: glm-4
# - OpenAI: gpt-4 / gpt-3.5-turbo
LLM_MODEL=abab6.5s-chat

# API Key（根据提供商选择）
# MiniMax: https://api.minimax.chat 注册获取
# DeepSeek: https://platform.deepseek.com 注册获取
# 智谱AI: https://open.bigmodel.cn 注册获取
# OpenAI: https://platform.openai.com 注册获取
LLM_API_KEY=your_api_key_here

# API Base URL（通常不需要修改）
LLM_BASE_URL=https://api.minimax.chat/v1

# API 端点配置（可选，自定义端点）
# OPENAI_ENDPOINT=https://your-custom-openai.com/v1/chat/completions
# MINIMAX_ENDPOINT=https://api.minimax.chat/v1/text/chatcompletion_v2
# DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
# ZHIPU_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 微信公众号配置
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
WECHAT_TOKEN=your_wechat_token
WECHAT_KEY=your_wechat_key_for_url_generation

# 微信公众号 API 端点配置（可选）
# 前三个由引擎（engine/wechat.js）使用；WECHAT_PUBLISH_URL 仅服务已归档流水线的正式发布：
# WECHAT_TOKEN_URL=https://api.weixin.qq.com/cgi-bin/token
# WECHAT_DRAFT_URL=https://api.weixin.qq.com/cgi-bin/draft/add
# WECHAT_PUBLISH_URL=https://api.weixin.qq.com/cgi-bin/freepublish/commit
# WECHAT_UPLOAD_URL=https://api.weixin.qq.com/cgi-bin/media/uploadimg

# 【已归档】数据库配置（可选）
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=wine_articles

# 【已归档】Redis配置（可选，用于缓存）
REDIS_HOST=localhost
REDIS_PORT=6379

# 应用配置
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Shanghai

# 模拟数据模式（开发调试用）
USE_MOCK_DATA=false

# ===== 【已归档】数据源配置 =====

# RSS源配置 - 逗号分隔多个URL
# 示例: https://site1.com/rss.xml,https://site2.com/rss.xml
# RSS_SOURCES=https://www.wine-world.com/articlerss/rss.aspx,https://www.decanter.com/feed/

# 聚合数据 API Key (新闻接口)
JUHE_API_KEY=your_juhe_api_key

# 天行数据 API Key (新闻接口)
TIANAPI_KEY=your_tianapi_key

# ===== 发布前置自检 / 出口 IP 变化监控 =====
# 家用宽带多为动态 IP，换网后白名单会失效，下一次发布才会失败。
# 用 npm run wechat:watch 常驻监控，IP 一变就通知你。

# 定时表达式（--daemon 模式使用），默认每天 8:00 检查一次
IP_WATCH_CRON=0 8 * * *
# 同类告警的冷却小时数，避免重复刷屏（默认 6）
IP_WATCH_COOLDOWN_HOURS=6

# --- 通知渠道（可选；全部留空则只做本地检查，不发通知）---

# Webhook：钉钉 / 企业微信 / 飞书 / Slack / Discord
NOTIFY_WEBHOOK_TYPE=dingtalk
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# 邮件（可选，需要 npm i nodemailer —— 已在依赖中）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 多个收件人用逗号分隔
MAIL_TO=

# ===== 网络代理配置（可选）=====

# HTTP/HTTPS 代理，用于解决DNS问题
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ===== 发布配置 =====

# 测试模式 - true只创建草稿，false正式发布
WECHAT_TEST_MODE=true

# 自动发布
WECHAT_AUTO_PUBLISH=true

# ===== 微信公众号RSS源配置 =====

# wewe-rss 服务地址（部署后填入）
# 示例: http://localhost:4000 或 https://your-domain.com
WEWERSS_SERVER=

# 微信公众号RSS源 - 逗号分隔多个URL
# 获取方式: 部署wewe-rss后，扫码授权，在公众号详情页获取RSS链接
# 格式: https://your-wewerss-server.com/feed/user/{biz_id}.xml
WECHAT_RSS_SOURCES=

# ===== AI 封面生成配置（可选但推荐）=====
# 引擎按 glm -> zimage -> gemini 顺序自动选择；可强制指定其一：
#   COVER_AI_PROVIDER=glm|zimage|gemini|auto
#   COVER_AI_TIMEOUT=60000
# 无可用 Key 或调用失败时，自动回退矢量封面（engine/cover.js），不影响发布。

# --- 国内提供商 ---

# 智谱（推荐，国内直连可用）
# 注册: https://open.bigmodel.cn
#   同一个 Key 同时用于：
#     1) 封面图（cogview-4 / cogview-3-flash）—— 见下方 GLM_IMAGE_MODEL
#     2) 自动写稿的**文本**模型（默认 glm-4-flash-250414）—— 见「文本大模型」一节
#   cogview-4 需付费余额；余额不足时引擎自动回退到免费的 cogview-3-flash
#   （cogview-3-flash 会在右下角带「AI生成」标识，属合规要求）
# 可用 GLM_IMAGE_MODEL 固定图片模型，如 GLM_IMAGE_MODEL=cogview-3-flash
GLM_API_KEY=

# ModelScope Z-Image（需 ModelScope 的 API Token，非普通登录密码）
# 端点: https://api-inference.modelscope.cn/v1/images/generations
# 可用 ZIMAGE_IMAGE_MODEL 指定模型，默认 z-image-turbo
ZIMAGE_API_KEY=

# --- 国际提供商 ---

# Google Gemini（国内需配 HTTP(S)_PROXY 才能连通）
# 注册: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- 自定义 / 兼容 OpenAI 风格的图像 API（如 Agnes）---
# 只要接口形如：
#   POST {AGNES_API_URL}  {model, prompt, size}  ->  {data:[{url|b64_json}]}
# 即可零改动接入（引擎会自动识别 data[].url / data[].b64_json / images[] / output[] 等）。
#
# 以 Agnes 为例（已实测）：
#   GET https://api.agnes-ai.cn/v1/models 可见图像模型 agnes-image-2.5-flash / agnes-image-2.1-flash
#   POST /v1/images/generations 返回 {data:[{url}]}，出图无水印
#   COVER_AI_PROVIDER=agnes
#   AGNES_API_URL=https://api.agnes-ai.cn/v1/images/generations
#   AGNES_API_KEY=
#   AGNES_MODEL=agnes-image-2.5-flash
#
# 非标准接口可用这些变量覆盖：
#   AGNES_SIZE=1024x1024
#   AGNES_AUTH_HEADER=Authorization
#   AGNES_AUTH_PREFIX=Bearer 
#   AGNES_EXTRA_JSON={"steps":8}
#   AGNES_RESPONSE_TYPE=auto|url|b64
# 通用别名：把 AGNES_ 换成 CUSTOM_IMAGE_（并用 COVER_AI_PROVIDER=custom）。
# ============================================================================
# 文本大模型（自动写稿：engine/llm.js + tools/generate-article.js）
# ============================================================================
# 作用：把 articles/_incoming/ 里的素材写成一篇合规文章（articles/<name>.json）。
# 任何兼容 OpenAI /chat/completions 的服务都能接 —— 在 engine/llm.js 的
# PROVIDERS 表里补一行即可（表里已有 zhipu / zai / deepseek / siliconflow /
# dashscope / agnes / openai）。
# 不配置任何文本 Key 时：generate-article.js 直接报错退出（fail-closed），
# **不会**用模板拼贴的假稿充数。

# 推荐：智谱 GLM（免费额度即可用，国内直连，无需代理）
# 复用上面的 GLM_API_KEY，无需再填一遍。可选覆盖：
#   GLM_TEXT_MODEL=glm-4-flash-250414   # 主力模型（快）
#   GLM_TEXT_MODEL=glm-4.5-flash        # 写不出长度时手动指定升档模型
#   GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 其它可选的文本提供商（填了 Key 就会在 auto 模式下被探测到）
# DEEPSEEK_API_KEY=
# SILICONFLOW_API_KEY=
# 阿里百炼（qwen-turbo）
# DASHSCOPE_API_KEY=
# OpenAI 官方（国内需代理，建议改用兼容端点覆盖 OPENAI_BASE_URL）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Agnes 文本需要**单独的**文本 Key（项目里的 AGNES_API_KEY 是图片 Key，
# 拿去聊天会返回 Invalid token）：
#   AGNES_TEXT_API_KEY=
#   AGNES_TEXT_BASE_URL=https://apihub.agnes-ai.com/v1

# 实测（2026-09-27，本机直连，同一份写稿提示词）：
#   zhipu glm-4-flash-250414  OK  1258 字 / 24s    主力
#   zhipu glm-4.5-flash       OK  2114 字 / 140s   升档
#   zhipu glm-4-flash         偏短 530~896 字      不合格
#   zai   glm-4.5-flash       返回空内容
#   dashscope qwen-turbo      失败 Incorrect API key
#   agnes agnes-3.0-flash     失败 Invalid token（用的是图片 Key）
#   minimax abab6.5s-chat     失败 insufficient balance
