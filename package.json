{
  "name": "wine-article-aggregator",
  "version": "1.0.0",
  "description": "葡萄酒公众号内容渲染与发布系统（engine 渲染引擎 + 发布工具链）",
  "main": "engine/cli.js",
  "scripts": {
    "test": "jest",
    "engine:check": "node engine/cli.js --all --check",
    "engine:render": "node engine/cli.js --all --cover --html",
    "engine:verify": "node tools/verify_parity.js",
    "engine:extract": "python tools/extract_articles.py --all",
    "news:fetch": "node tools/fetch-news.js",
    "wechat:check": "node tools/check-wechat-ip.js",
    "wechat:watch": "node tools/ip-watch.js --daemon",
    "wechat:watch:once": "node tools/ip-watch.js",
    "notify:verify": "node tools/verify-notify.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.3",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "overrides": {
    "ws": "^8.21.3",
    "uuid": "^11.1.1",
    "undici": "^7.29.1",
    "@tootallnate/once": "^2.0.1"
  }
}
